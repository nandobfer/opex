{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".opex-sdk/types/*.d.ts"],
  "exclude": ["node_modules", ".opex-sdk/testing", ".opex-sdk/skeleton", ".opex-sdk/template"]
}
