# Copie para .env e preencha. Nunca versione valores reais.

# Aplicação
APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=3100
# Subcaminho público quando o app fica atrás de proxy com prefixo (ex.: /dev_automacao/tarefas-fernando).
# Vale também no acesso direto (http://IP:PORT/ redireciona para ele). Entra no build: mudar exige rebuild.
NEXT_PUBLIC_BASE_PATH=
# Nome exibido no rodapé do menu e gravado na auditoria (app de uso pessoal, sem login)
APP_OWNER_NAME=

# Banco — valores para o Docker (rede devteam). Rodando com `pnpm dev` fora do Docker, troque o
# host por localhost (ex.: mongodb://localhost:27017/opex).
MONGODB_URI=mongodb://devteam-mongo:27017/opex

# Integrações (segredos salvos no banco são cifrados com esta chave: 32 bytes em base64)
# openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# Agendador interno (Docker/local)
CRON_SECRET=

# Pusher (fallback legado; a configuração oficial fica na tela de Integrações)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
# Conexão: "cluster" (Pusher na nuvem, usa PUSHER_CLUSTER) ou "host" (Soketi/servidor próprio, usa PUSHER_URL)
PUSHER_MODE=
PUSHER_CLUSTER=
# Origem sem caminho. Servidor no Docker: http://devteam-soketi:6001 (fora do Docker,
# http://localhost:6001). NEXT_PUBLIC_PUSHER_URL é o endereço que o NAVEGADOR alcança: com o app
# aberto de outra máquina, use o IP do servidor (ex.: ws://192.168.0.64:6001), nunca localhost.
# NEXT_PUBLIC_PUSHER_URL aceita vários endereços separados por vírgula, com caminho de proxy (o navegador usa
# o de mesmo host da página), ex.: ws://192.168.0.64:6001, wss://meudominio.com/dev_automacao/soketi
PUSHER_URL=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_URL=

# Logs
LOG_LEVEL=info
